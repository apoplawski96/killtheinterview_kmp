CREATE TABLE QuestionBookmark (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    questionId INTEGER NOT NULL UNIQUE,
    question TEXT NOT NULL,
    answer TEXT NOT NULL,
    categories TEXT NOT NULL
);

insertQuestionBookmark:
INSERT INTO QuestionBookmark (
    questionId,
    question,
    answer,
    categories
) VALUES (?, ?, ?, ?);

deleteQuestionBookmarkById:
DELETE FROM QuestionBookmark
WHERE id = ?;

getAllQuestionBookmarks:
SELECT * FROM QuestionBookmark;

getQuestionBookmarkById:
SELECT * FROM QuestionBookmark
WHERE id = ?;